{block content}
<style>
    body {
        font-family: DejaVu Sans, sans-serif;
        font-size: 12px;
        color: #333;
        background-color: #fff;
    }
    .header {
        text-align: center;
        margin-bottom: 30px;
    }
    .section-title {
        font-size: 14px;
        font-weight: bold;
        margin-top: 30px;
        margin-bottom: 10px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 3px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }
    td, th {
        padding: 6px;
        vertical-align: top;
    }
    .details-table td {
        width: 33%;
    }
    .items th, .items td {
        border: 1px solid #aaa;
        text-align: left;
    }
    .items th {
        background-color: #f0f0f0;
    }
    .summary th, .summary td {
        padding: 6px;
        text-align: left;
    }
    .summary td:last-child {
        text-align: right;
    }
    .summary-row {
        border-top: 1px solid #ccc;
    }
    .total-row td {
        font-weight: bold;
        font-size: 13px;
    }
    .payment-details {
        margin-top: 30px;
    }
</style>

<div class="header">
    <h1>Faktura / Přehled objednávky č. {$order->id}</h1>
    <p>Datum vytvoření: {$order->created_at|date:'d.m.Y'}</p>
</div>

<div class="section-title">Informace o zákazníkovi</div>
<table class="details-table">
    <tr>
        <td>
            <strong>Odběratel:</strong><br>
            {$recipient}
        </td>
        <td>
            <strong>Adresa:</strong><br>
            {$order->address}<br>
            {$order->city}, {$order->psc}
        </td>
        <td>
            <strong>Kontakt:</strong><br>
            E-mail: {$order->email}<br>
            Tel: {$order->phone}
        </td>
    </tr>
</table>

<div class="section-title">Doprava a platba</div>
<table class="details-table">
    <tr>
        <td><strong>Způsob dopravy:</strong><br>{$order->shipping}</td>
        <td><strong>Místo doručení:</strong><br>{$order->delivery_point ?: 'Není zadáno'}</td>
        <td><strong>Způsob platby:</strong><br>{$order->payment == 'DOBIRKA' ? 'Dobírka' : 'Bankovní převod'}</td>
    </tr>
</table>

<div class="section-title">Položky objednávky</div>
<table class="items">
    <thead>
        <tr>
            <th>#</th>
            <th>ID</th>
            <th>Výrobce</th>
            <th>Model</th>
            <th>Barva</th>
            <th>Vlastnosti</th>
            <th>Množství</th>
            <th>Cena/ks (Kč)</th>
            <th>Celkem (Kč)</th>
        </tr>
    </thead>
    <tbody>
        {foreach $items as $i => $item}
            <tr>
                <td>{$i + 1}</td>
                <td>{$item->id}</td>
                <td>{$item->manufacturer}</td>
                <td>{$item->model}</td>
                <td>{$item->color}</td>
                <td>
                    {foreach $item->features as $key => $value}
                        {$key}: {$value}<br>
                    {/foreach}
                </td>
                <td>{$item->quantity}</td>
                <td>{number_format($item->total_price, 2, ',', ' ')}</td>
                <td>{number_format($item->total_price * $item->quantity, 2, ',', ' ')}</td>
            </tr>
        {/foreach}
    </tbody>
</table>

<div class="section-title">Shrnutí objednávky</div>
<table class="summary">
    <tbody>
        <tr>
            <td>Mezisoučet položek:</td>
            <td>{number_format($itemsSubtotal, 2, ',', ' ')} Kč</td>
        </tr>
        <tr>
            <td>Doprava – {$order->shipping}:</td>
            <td>{number_format($shippingCost, 2, ',', ' ')} Kč</td>
        </tr>
        <tr>
            <td>Platba – {$order->payment == 'DOBIRKA' ? 'Dobírka' : 'Bankovní převod'}:</td>
            <td>{number_format($paymentCost, 2, ',', ' ')} Kč</td>
        </tr>
        <tr class="total-row">
            <td>Celková částka k úhradě:</td>
            <td>{number_format($total, 2, ',', ' ')} Kč</td>
        </tr>
    </tbody>
</table>


<div class="payment-details">
    <div class="section-title">Platební údaje</div>
    {if $order->payment == 'PREVOD'}
        <p>
            <strong>Bankovní účet:</strong> 1234567890/0800<br>
            <strong>Variabilní symbol:</strong> {$order->variable_symbol}<br>
            <strong>Částka k úhradě:</strong> {number_format($total, 2, ',', ' ')} Kč
        </p>
    {else}
        <p>
            <strong>Platba při převzetí:</strong> <br>
            Částka k úhradě: {number_format($total, 2, ',', ' ')} Kč<br>
            Připravte si prosím hotovost při převzetí zásilky.
        </p>
    {/if}
</div>
{/block}
