<h1>Faktura č. {$order->id}</h1>
<p>Datum: {$order->created_at|date:'d.m.Y'}</p>
<p>Odběratel: {$recipient}</p>
<p>Adresa: {$order->address}, {$order->city}, {$order->psc}</p>
<hr>
<table border="1" cellpadding="5" cellspacing="0" width="100%">
    <thead>
        <tr><th>Položka</th><th>Množství</th></tr>
    </thead>
    <tbody>
    {foreach $items as $item}
        <tr>
            <td>Kryt č. {$item->id}</td>
            <td>{$item->quantity}</td>
        </tr>
    {/foreach}
    </tbody>
</table>
