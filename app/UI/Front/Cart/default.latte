{block content}
<style>
/* Define variables with dark mode support */
:root {
    --color-background-secondary: #f9fafb; /* Light mode: light gray */
    --color-text-secondary: #6b7280;      /* Light mode: medium gray */
    --color-accent-light: #dbeafe;        /* Light mode: light blue */
}

[data-theme="dark"] {
    --color-background-secondary: #1e293b; /* Dark mode: dark blue-gray */
    --color-text-secondary: #9ca3af;      /* Dark mode: light gray */
    --color-accent-light: #4b6cb7;        /* Dark mode: muted blue */
}

.progress-bar {
    background-color: var(--color-background);
}
.step {
    flex: 1;
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    position: relative;
    z-index: 1;
}
@media (max-width: 640px) {
    .step {
        font-size: 0.9rem;
    }
    .step-number {
        width: 1.5rem;
        height: 1.5rem;
        line-height: 1.5rem;
        margin-right: 0.3rem;
    }
}
.step.active {
    color: var(--color-accent); /* Use accent for better contrast in dark mode */
    font-weight: bold;
}
.step.completed {
    color: var(--color-accent);
}
.step-number {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    line-height: 2rem;
    border-radius: 50%;
    background-color: var(--color-secondary);
    color: var(--button-text); /* Use button-text for consistency */
    margin-right: 0.5rem;
}
.step.active .step-number {
    background-color: var(--color-accent); /* Use accent for better contrast */
}
.step.completed .step-number {
    background-color: var(--color-accent);
}
.step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 2.5rem;
    left: calc(50% + 1.25rem);
    width: calc(100% - 2.5rem);
    height: 4px;
    background-color: var(--color-secondary);
    z-index: -1;
}

.features-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
}
.feature-item {
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.3;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    transition: background-color 0.3s ease;
    user-select: none;
}
.feature-item:hover {
    background-color: var(--color-accent-light);
}
.feature-label {
    font-weight: 600;
    color: var(--color-text-secondary);
}
.feature-value {
    color: var(--color-text);
}
.bg-white:hover {
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
}

/* Ensure buttons have readable text */
.btn {
    background-color: var(--color-primary);
    color: var(--button-text);
}
.btn:hover {
    background-color: var(--color-accent);
}
</style>

<div class="progress-bar bg-[var(--color-background)] p-4 mb-8 rounded-lg shadow">
    <div class="flex justify-between items-center">
        <div class="step {if $presenter->action === 'default'}active{else}completed{/if}">
            <span class="step-number">1</span> Košík
        </div>
        <div class="step {if $presenter->action === 'order'}active{elseif $presenter->action === 'info'}completed{else}inactive{/if}">
            <span class="step-number">2</span> Doprava a platba
        </div>
        <div class="step {if $presenter->action === 'info'}active{else}inactive{/if}">
            <span class="step-number">3</span> Osobní údaje
        </div>
    </div>
</div>

{if empty($cases)}
    <div class="container mx-auto max-w-4xl px-9">
        <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 text-center">Shrnutí košíku</h2>
        <div class="text-center py-16 px-6 bg-[var(--color-background)] rounded-2xl shadow-2xl">
            <p class="text-2xl font-medium text-[var(--color-text)] mb-6">Nemáte žádné kryty v košíku.</p>
            <a n:href="Home:configurator" class="inline-block btn px-6 py-3 rounded-xl text-lg font-semibold transition hover:scale-105" style="background-color: var(--color-primary); color: var(--button-text);">Navrhnout kryt</a>
        </div>
    </div>
{else}
<div class="container mx-auto max-w-4xl px-9">
    <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 text-center">Shrnutí košíku</h2>
    <form action="{$presenter->link('CreateOrder')}" method="post" class="bg-[var(--color-background)] p-8 rounded-3xl shadow-2xl overflow-x-auto">
    <div class="space-y-6">
        {foreach $cases as $case}
            <div class="bg-[var(--color-background-secondary)] text-[var(--color-text)] shadow transition hover:shadow-lg duration-300 rounded-2xl p-6" data-case-id="{$case->id}" data-price="{$case->total_price}">
                <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
                    <div>
                        <h3 class="text-lg font-semibold mb-1">Výrobce</h3>
                        <p class="text-base leading-relaxed">{$case->manufacturer}</p>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold mb-1">Model</h3>
                        <p class="text-base leading-relaxed">{$case->model}</p>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold mb-1">Barva</h3>
                        <p class="text-base leading-relaxed">{$case->color}</p>
                    </div>
                    <div class="md:col-span-2">
                        <h3 class="text-lg font-semibold mb-2">Funkce</h3>
                        {if $case->features}
                            <ul class="features-list grid grid-cols-2 gap-2 mb-0">
                                {foreach $case->features as $label => $value}
                                    <li class="feature-item px-3 py-2 rounded border border-transparent transition-colors duration-300">
                                        <span class="feature-label font-semibold text-[var(--color-text-secondary)]">{$label}:</span>
                                        <span class="feature-value text-[var(--color-text)]"> {$value}</span>
                                    </li>
                                {/foreach}
                            </ul>
                        {else}
                            <p class="text-[var(--color-text-secondary)]">Žádné funkce</p>
                        {/if}
                    </div>
                    <div class="flex flex-col space-y-2">
                        <h3 class="text-lg font-semibold mb-1">Množství</h3>
                        <input type="number" name="quantities[{$case->id}][amount]" value="{$quantities[$case->id] ?? 1}" min="1"
                            class="w-20 text-center border border-[var(--color-secondary)] rounded-lg focus:ring-2 focus:ring-[var(--color-accent)] bg-[var(--color-secondary)] focus:outline-none transition quantity-input">
                        <a class="inline-flex items-center justify-center text-sm font-semibold text-white rounded-lg px-4 py-2 transition transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-red-400"
                           style="background-color: #ef4444;"
                           href="{link removeCase! $case->id}"
                           onclick="return confirm('Opravdu chcete odstranit tento kryt z košíku?')">
                            <i class="fas fa-trash mr-2"></i> Odstranit
                        </a>
                    </div>
                </div>
            </div>
        {/foreach}
        <div class="flex justify-end mt-10">
            <div class="mr-4 text-lg font-semibold text-[var(--color-text)]">
                Celková cena: <span class="text-[var(--color-accent)] total-value">{number_format($totalCartValue, 2, ',', ' ')} Kč</span>
            </div>
            <button type="submit" class="btn px-8 py-4 rounded-2xl text-lg font-bold transition transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-[var(--color-accent)]"
                style="background-color: var(--color-primary); color: var(--button-text);">
                Pokračovat k objednávce
            </button>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const quantityInputs = document.querySelectorAll('.quantity-input');
        const totalValueElement = document.querySelector('.total-value');

        function updateTotal() {
            let total = 0;
            quantityInputs.forEach(input => {
                const card = input.closest('[data-case-id]');
                const price = parseFloat(card.getAttribute('data-price'));
                const quantity = parseInt(input.value) || 1;
                total += price * quantity;
            });
            totalValueElement.textContent = total.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' Kč';
        }

        quantityInputs.forEach(input => {
            input.addEventListener('input', updateTotal);
        });

        // Initial calculation
        updateTotal();
    });
</script>
{/if}
{/block}