{block content}
{if empty($cases)}
    <div class="text-center py-16 px-6 bg-[var(--color-background)] rounded-2xl shadow-2xl">
        <p class="text-2xl font-medium text-[var(--color-text)] mb-6">Nemáte žádné kryty v košíku.</p>
        <a href="{$basePath}/" class="inline-block btn px-6 py-3 rounded-xl text-lg font-semibold transition hover:scale-105" style="background-color: var(--color-primary); color: var(--button-text);">Pokračovat v nákupu</a>
    </div>
{else}
    <form action="{$presenter->link('CreateOrder')}" method="post" class="bg-[var(--color-background)] p-8 rounded-3xl shadow-2xl overflow-x-auto">
        <div class="space-y-6">
            {foreach $cases as $case}
                <div class="bg-white dark:bg-[var(--color-secondary)] text-[var(--color-text)] shadow transition hover:shadow-lg duration-300 rounded-2xl p-6" data-case-id="{$case->id}" data-price="{$case->total_price}">
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                        <div>
                            <h3 class="text-lg font-semibold mb-1">Výrobce</h3>
                            <p class="text-base leading-relaxed">{$case->manufacturer}</p>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold mb-1">Model</h3>
                            <p class="text-base leading-relaxed">{$case->model}</p>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold mb-1">Barva</h3>
                            <p class="text-base leading-relaxed">{$case->color}</p>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold mb-2">F</h3>
                            {if $case->features}
                                <ul class="features-list grid grid-cols-2 gap-2 mb-0">
                                    {foreach $case->features as $label => $value}
                                        <li class="feature-item px-3 py-2 rounded border border-transparent transition-colors duration-300">
                                            <span class="feature-label font-semibold text-[var(--color-text-secondary)]">{$label}:</span>
                                            <span class="feature-value text-[var(--color-text)]"> {$value}</span>
                                        </li>
                                    {/foreach}
                                </ul>
                            {else}
                                <p class="text-[var(--color-text-secondary)]">Žádné vlastnosti</p>
                            {/if}
                        </div>
                        <div class="flex flex-col space-y-2">
                            <h3 class="text-lg font-semibold mb-1">Množství</h3>
                            <input type="number" name="quantities[{$case->id}][amount]" value="{$quantities[$case->id] ?? 1}" min="1"
                                class="w-20 text-center border border-[var(--color-secondary)] rounded-lg focus:ring-2 focus:ring-[var(--color-accent)] focus:outline-none transition quantity-input">
                            <a class="inline-flex items-center justify-center text-sm font-semibold text-white rounded-lg px-4 py-2 transition transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-red-400"
                               style="background-color: #ef4444;"
                               href="{link removeCase! $case->id}"
                               onclick="return confirm('Opravdu chcete odstranit tento kryt z košíku?')">
                                <i class="fas fa-trash mr-2"></i> Odstranit
                            </a>
                        </div>
                    </div>
                </div>
            {/foreach}
            <div class="flex justify-end mt-10">
                <div class="mr-4 text-lg font-semibold text-[var(--color-text)]">
                    Celková cena: <span class="text-[var(--color-primary)] total-value">{number_format($totalCartValue, 2, ',', ' ')} Kč</span>
                </div>
                <button type="submit" class="btn px-8 py-4 rounded-2xl text-lg font-bold transition transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-[var(--color-accent)]"
                    style="background-color: var(--color-primary); color: var(--button-text);">
                    Pokračovat k objednávce
                </button>
            </div>
        </div>
    </form>

    <style>
        .features-list {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }
        .feature-item {
            background-color: var(--color-background-secondary, #f9fafb);
            color: var(--color-text-secondary, #6b7280);
            font-size: 0.9rem;
            line-height: 1.3;
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            transition: background-color 0.3s ease;
            user-select: none;
        }
        .feature-item:hover {
            background-color: var(--color-accent-light, #dbeafe);
        }
        .feature-label {
            font-weight: 600;
            color: var(--color-text-secondary, #4b5563);
        }
        .feature-value {
            color: var(--color-text, #111827);
        }
        /* Optional: subtle card hover shadow */
        .bg-white:hover {
            box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quantityInputs = document.querySelectorAll('.quantity-input');
            const totalValueElement = document.querySelector('.total-value');

            function updateTotal() {
                let total = 0;
                quantityInputs.forEach(input => {
                    const card = input.closest('[data-case-id]');
                    const price = parseFloat(card.getAttribute('data-price'));
                    const quantity = parseInt(input.value) || 1;
                    total += price * quantity;
                });
                totalValueElement.textContent = total.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' Kč';
            }

            quantityInputs.forEach(input => {
                input.addEventListener('input', updateTotal);
            });

            // Initial calculation
            updateTotal();
        });
    </script>
{/if}
{/block}