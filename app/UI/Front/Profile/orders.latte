{block title}OPNX3D | {_'profile.orders_title'}{/block}
{block content}
<style>
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--color-text);
}

.table-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
}

h1 {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    text-align: left;
}

.btn-primary {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    background-color: var(--color-primary);
    color: var(--button-text);
    border: none;
    text-decoration: none;
    transition: background-color 0.2s ease;
    margin-bottom: 1rem; /* Added for spacing below button */
}

.btn-primary:hover {
    background-color: var(--color-accent);
}

.alert-info {
    background-color: var(--color-background);
    border: 1px solid var(--color-secondary);
    color: var(--color-text);
    padding: 1rem;
    border-radius: 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
}

.table {
    width: 100%;
    background-color: var(--color-background);
    border-collapse: collapse;
    border-radius: 0.5rem;
    overflow: hidden;
}

.table thead {
    background-color: var(--color-secondary);
    color: var(--color-text);
}

.table th {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: left;
    text-transform: uppercase;
}

.table td {
    padding: 1rem;
    font-size: 0.875rem;
    border-bottom: 1px solid var(--color-secondary);
}

.table tbody tr:last-child td {
    border-bottom: none;
}

.table-hover tbody tr:hover {
    background-color: rgba(var(--color-secondary), 0.05);
}

.badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 1rem;
    text-transform: uppercase;
}

.badge.bg-secondary { background-color: #e5e7eb; color: #374151; }
.badge.bg-warning { background-color: #fef3c7; color: #d97706; }
.badge.bg-success { background-color: #d1fae5; color: #059669; }
.badge.bg-info { background-color: #cffafe; color: #0e7490; }
.badge.bg-primary { background-color: var(--color-primary); color: var(--button-text); }
.badge.bg-dark { background-color: #1f2937; color: white; }
.badge.bg-light { background-color: #f3f4f6; color: #6b7280; }

.table td ul {
    padding-left: 1rem;
    margin: 0;
}

.table td ul li {
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
}

.table td ul li small {
    font-size: 0.75rem;
}

.table td ul.list-disc {
    list-style-type: disc;
    padding-left: 1.5rem;
}

/* Mobile styles */
@media (max-width: 640px) {
    .table-container {
        padding: 1rem;
    }

    h1 {
        font-size: 1.5rem;
    }

    .btn-primary {
        font-size: 0.8125rem;
        padding: 0.5rem 0.75rem;
        margin-bottom: 0.75rem; /* Adjusted for mobile */
    }

    .alert-info {
        font-size: 0.8125rem;
        padding: 0.75rem;
    }

    .table {
        display: block;
    }

    .table thead {
        display: none;
    }

    .table tbody {
        display: block;
    }

    .table tr {
        display: block;
        margin-bottom: 1rem;
        border: 1px solid var(--color-secondary);
        border-radius: 0.5rem;
        background-color: var(--color-background);
        padding: 0.75rem;
    }

    .table td {
        display: block;
        padding: 0.5rem 0;
        border: none;
    }

    .table td:before {
        content: attr(data-label);
        font-weight: 500;
        color: var(--color-text-secondary);
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .table td:last-child {
        border-bottom: none;
    }
}
</style>
<div class="table-container">
    <div class="button-container">
        <a n:href="default, lang => $lang" class="btn btn-primary">{_'profile.back'}</a>
    </div>
    <h1>{_'profile.orders_title'}</h1>

    {if !$orders || count($orders) === 0}
        <div class="alert alert-info">{_'profile.no_orders'}</div>
    {else}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th>{_'orders.id'}</th>
                    <th>{_'orders.address'}</th>
                    <th>{_'orders.state'}</th>
                    <th>{_'orders.payment'}</th>
                    <th>{_'orders.date'}</th>
                    <th>{_'orders.items'}</th>
                    <th>{_'orders.total_price'}</th>
                </tr>
                </thead>
                <tbody>
                {foreach $orders as $orderData}
                    <tr>
                        <td data-label="{_'orders.id'}">{$orderData['order']->id}</td>
                        <td data-label="{_'orders.address'}">
                            {$orderData['order']->address}<br>
                            {$orderData['order']->city}, {$orderData['order']->psc}
                        </td>
                        <td data-label="{_'orders.state'}">
                            {switch $orderData['order']->state}
                                {case 'KOSIK'} <span class="badge bg-secondary">{_'orders.state.cart'}</span>
                                {case 'OBJEDNANO'} <span class="badge bg-warning">{_'orders.state.ordered'}</span>
                                {case 'ZAPLACENO'} <span class="badge bg-success">{_'orders.state.paid'}</span>
                                {case 'ODESLANO'} <span class="badge bg-info">{_'orders.state.shipped'}</span>
                                {case 'DORUCENO'} <span class="badge bg-primary">{_'orders.state.delivered'}</span>
                                {case 'VYZVEDNUTO'} <span class="badge bg-dark">{_'orders.state.picked_up'}</span>
                                {default} <span class="badge bg-light">{_'orders.state.unknown'}</span>
                            {/switch}
                        </td>
                        <td data-label="{_'orders.payment'}">{$orderData['order']->payment ?? '—'}</td>
                        <td data-label="{_'orders.date'}">{$orderData['order']->created_at|date:'j. n. Y H:i'}</td>
                        <td data-label="{_'orders.items'}">
                            {if count($orderData['cases']) > 0}
                                <ul class="mb-0 ps-3">
                                    {foreach $orderData['cases'] as $case}
                                        <li>
                                            <strong>{$case->manufacturer} {$case->model}</strong>
                                            <small class="text-muted">({$case->color})</small>
                                            <br>
                                            {if is_array($case->features) && count($case->features) > 0}
                                                <ul class="small ps-3 mb-1 list-disc">
                                                    {foreach $case->features as $key => $value}
                                                        <li>
                                                            <span class="font-semibold">{$key}</span>: {$value}
                                                        </li>
                                                    {/foreach}
                                                </ul>
                                            {else}
                                                <small class="text-muted">{_'orders.no_features'}</small>
                                            {/if}
                                        </li>
                                    {/foreach}
                                </ul>
                            {else}
                                <em>{_'orders.no_items'}</em>
                            {/if}
                        </td>
                        <td data-label="{_'orders.total_price'}">
                            <strong>{if $lang === 'en'}{$orderData['order']->total_price_eur|number:2,',',' '} €{else}{$orderData['order']->total_price|number:2,',',' '} Kč{/if}</strong>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    {/if}
</div>
{/block}