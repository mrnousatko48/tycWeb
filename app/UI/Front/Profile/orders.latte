{block content}
<a n:href="default" class="btn btn-primary">Zpět</a>
<h1 class="text-3xl font-bold mb-5 text-[var(--color-text)] text-center">Objednávky</h1>


{if !$orders || count($orders) === 0}
    <div class="alert alert-info">Nemáte žádné objednávky.</div>
{else}
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Adresa</th>
                <th>Stav</th>
                <th>Platba</th>
                <th>Datum</th>
                <th>Položky</th>
                <th>Celková cena</th>
            </tr>
            </thead>
            <tbody>
            {foreach $orders as $orderData}
                <tr>
                    <td>{$orderData['order']->id}</td>
                    <td>
                        {$orderData['order']->address}<br>
                        {$orderData['order']->city}, {$orderData['order']->psc}
                    </td>
                    <td>
                        {switch $orderData['order']->state}
                            {case 'KOSIK'} <span class="badge bg-secondary">Košík</span>
                            {case 'OBJEDNANO'} <span class="badge bg-warning text-dark">Objednáno</span>
                            {case 'ZAPLACENO'} <span class="badge bg-success">Zaplaceno</span>
                            {case 'ODESLANO'} <span class="badge bg-info text-dark">Odesláno</span>
                            {case 'DORUCENO'} <span class="badge bg-primary">Doručeno</span>
                            {case 'VYZVEDNUTO'} <span class="badge bg-dark">Vyzdvihnuto</span>
                            {default} <span class="badge bg-light text-muted">Neznámý</span>
                        {/switch}
                    </td>
                    <td>{$orderData['order']->payment ?? '—'}</td>
                    <td>{$orderData['order']->created_at|date:'j. n. Y H:i'}</td>
                    <td>
                        {if count($orderData['cases']) > 0}
                            <ul class="mb-0 ps-3">
                                {foreach $orderData['cases'] as $case}
                                    <li>
                                        <strong>{$case->manufacturer} {$case->model}</strong>
                                        <small class="text-muted">({$case->color})</small>
                                        <br>
                                        {var $features = json_decode($case->features ?? '{}', true)}
                                        {if is_array($features)}
                                            <ul class="small ps-3 mb-1">
                                                {foreach $features as $key => $value}
                                                    <li><strong>{$key|capitalize}</strong>: {$value}</li>
                                                {/foreach}
                                            </ul>
                                        {/if}
                                    </li>
                                {/foreach}
                            </ul>
                        {else}
                            <em>Žádné položky</em>
                        {/if}
                    </td>
                    <td>
                        {var $total = 0}
                        {foreach $orderData['cases'] as $case}
                            {do $total += $case->total_price}
                        {/foreach}
                        <strong>{number_format($total, 2, ',', ' ')} Kč</strong>
                    </td>
                </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
{/if}
{/block}
