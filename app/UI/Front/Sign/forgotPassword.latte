{block content}
<style>
/* Form page styling for Forgot Password and Sign In */
.form-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    padding: 2rem;
}

.form-container {
    max-width: 400px;
    width: 100%;
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.form-container:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

.form-container h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 1.5rem;
    text-align: center;
}

.form-container p {
    font-size: 1.125rem;
    color: #4b5563;
    margin-bottom: 1.5rem;
    text-align: center;
}

/* Style Nette's default form structure */
.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    font-size: 1.1rem;
    color: #4b5563;
    margin-bottom: 0.5rem;
}

.form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 1rem;
    color: #1f2937   ;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.form-group input::placeholder {
    color: #6b7280;
    opacity: 0.8;
}

.form-group input:focus {
    outline: none;
    border-color: #007bff   ;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1)   ;
}

/* Target Nette's default input class if present */
.nette-form-input {
    width: 100% ;
    padding: 0.75rem ;
    border: 1px solid #e5e7eb ;
    border-radius: 0.5rem ;
    font-size: 1rem ;
    color: #1f2937 ;
}

.nette-form-input:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
}

/* Error styling for Nette forms */
.form-group .error {
    color: #dc3545;
    font-size: 0.9rem;
    margin-top: 0.25rem;
}

.form-group.error input,
.form-group.error .nette-form-input {
    border-color: #dc3545;
}

/* Submit button */
.form-group input[type="submit"] {
    display: inline-block;
    width: 100%;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    background-color: #007bff;
    color: #ffffff;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
}

.form-group input[type="submit"]:hover {
    background-color: #0056b3;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

/* Links (Sign Up and Forgot Password) */
.btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
}

.btn-outline-success {
    background-color: transparent;
    color: #28a745;
    border: 2px solid #28a745;
    margin: 0.5rem;
}

.btn-outline-success:hover {
    background-color: #28a745;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

/* Flash messages */
.flash {
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    text-align: center;
}

.flash.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.flash.danger {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.text-center {
    text-align: center;
}

/* Ensure custom-form class (used in Forgot and Reset Password forms) inherits styles */
.custom-form {
    width: 100%;
}
</style>

<div class="form-section">
    <div class="form-container">
        <h1 n:block=title class="text-center">Zapomenuté heslo</h1>
        <p class="text-center">Zadejte svůj email a my vám pošleme ověřovací kód pro obnovu hesla.</p>

        {foreach $flashes as $flash}
            <div class="flash {$flash->type}">{$flash->message}</div>
        {/foreach}

        {form forgotPasswordForm}
            <div class="form-group">
                <label n:name="email">Váš email:</label>
                {input email}
                {if $form[email]->hasErrors()}<div class="error">{$form[email]->getError()}</div>{/if}
            </div>
            <div class="form-group">
                {input send}
            </div>
        {/form}

        <div class="text-center">
            <a n:href="Sign:in" class="btn btn-outline-success">Zpět na přihlášení</a>
        </div>
    </div>
</div>
{/block}