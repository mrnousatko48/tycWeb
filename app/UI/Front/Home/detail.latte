{block content}
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            @apply bg-gray-50;
        }
        .selected {
            @apply ring-2 ring-black ring-offset-2;
        }
    </style>
<div class="max-w-6xl mx-auto px-4 py-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <!-- Gallery -->
    <div class="w-full">
        <div class="relative h-72 md:h-96">
            <div class="overflow-hidden rounded-2xl shadow-lg h-full">
                <div class="flex h-full transition-transform duration-700 ease-in-out" id="carousel-track">
                    <!-- Images will be inserted here by JavaScript -->
                </div>
            </div>

            <!-- Navigation buttons -->
            <button onclick="prevSlide()" class="absolute top-1/2 -left-4 transform -translate-y-1/2 bg-black bg-opacity-40 hover:bg-opacity-70 text-white rounded-full p-2">
                ←
            </button>
            <button onclick="nextSlide()" class="absolute top-1/2 -right-4 transform -translate-y-1/2 bg-black bg-opacity-40 hover:bg-opacity-70 text-white rounded-full p-2">
                →
            </button>
        </div>

        <!-- Dots -->
        <div class="flex justify-center mt-3 space-x-2" id="carousel-dots">
            <!-- Dots will be inserted here by JavaScript -->
        </div>
    </div>

    <!-- Rest of the template remains the same -->
    <div class="w-full">
        <div class="space-y-6">
            <h1 class="text-3xl font-semibold text-gray-900">Kryt na telefon</h1>
            <p class="text-lg text-gray-600">Vyberte si svůj styl a přizpůsobte si kryt podle svých potřeb.</p>
            <div class="text-xl font-medium text-gray-900">
                Celková cena: <span id="total-price">0 Kč</span>
                <div id="price-breakdown" class="text-sm text-gray-600 mt-1"></div>
            </div>
            <p class="text-sm text-gray-500">Kompatibilní s: <span id="selected-device">Vyberte výrobce a model</span></p>

            {form caseForm}
                <div>
                    <h2 class="text-xl font-medium text-gray-900">Model telefonu</h2>
                    <div class="mt-2 flex space-x-3">
                        {input manufacturer class => 'px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 focus:ring-2 focus:ring-black transition'}
                        {input model class => 'px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 focus:ring-2 focus:ring-black transition', data-colors-url => '/endpoint/model-colors?modelId=#', data-features-url => '/endpoint/model-features?modelId=#', data-price-url => '/endpoint/model-price?modelId=#', data-images-url => '/endpoint/model-images?modelId=#'}
                    </div>
                </div>

                <div>
                    <h2 class="text-xl font-medium text-gray-900">Barva</h2>
                    <div id="color-buttons" class="mt-2 flex space-x-3">
                        <!-- Color buttons will be inserted here by JavaScript -->
                    </div>
                </div>
                {input color type => 'hidden', id => 'frm-caseForm-color'}

                <div id="features">
                    <!-- Feature sections will be inserted here by JavaScript -->
                </div>

                <div>
                    {input features type => 'hidden', id => 'frm-caseForm-features'}
                    {input total_price type => 'hidden', id => 'frm-caseForm-total_price'}
                    {input submit class => 'w-full py-3 bg-black text-white rounded-lg hover:bg-gray-800 focus:ring-2 focus:ring-black transition'}
                </div>
            {/form}
        </div>
    </div>
</div>

<!-- Add Alpine.js for interactivity (if not already included) -->
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

<script n:syntax=off>
    let basePrice = 0;
    let featurePrices = {};
    let selectedFeatures = {};
    let currentImages = [];

    document.querySelectorAll('select[data-depends]').forEach((childSelect) => {
        let parentSelect = childSelect.form[childSelect.dataset.depends];
        let url = childSelect.dataset.url;
        let items = JSON.parse(childSelect.dataset.items || 'null');

        parentSelect.addEventListener('change', () => {
            if (items) {
                updateSelectbox(childSelect, items[parentSelect.value]);
            }
            if (url) {
                fetch(url.replace(encodeURIComponent('#'), encodeURIComponent(parentSelect.value)))
                    .then((response) => response.json())
                    .then((data) => updateSelectbox(childSelect, data));
            }
        });
    });

    function updateSelectbox(select, items) {
        select.innerHTML = '';
        let defaultOption = document.createElement('option');
        defaultOption.setAttribute('value', '');
        defaultOption.setAttribute('disabled', 'disabled');
        defaultOption.setAttribute('selected', 'selected');
        defaultOption.innerText = select.dataset.prompt || 'Vyberte';
        select.appendChild(defaultOption);
        for (let id in items) {
            let el = document.createElement('option');
            el.setAttribute('value', id);
            el.innerText = items[id];
            select.appendChild(el);
        }
        select.disabled = Object.keys(items).length === 0;
    }

    function toggleSelection(button) {
        const featureId = button.dataset.feature;
        const group = button.parentElement.parentElement.querySelectorAll(`button[data-feature="${featureId}"]`);

        group.forEach(btn => {
            btn.classList.remove('ring-2', 'ring-black', 'ring-offset-2');
        });

        button.classList.add('ring-2', 'ring-black', 'ring-offset-2');
        selectedFeatures[featureId] = {
            name: button.dataset.value,
            price: parseFloat(button.dataset.price) || 0
        };

        updateFeaturesInput();
        updateTotalPrice();
    }

    function updateFeaturesInput() {
        const features = {};
        for (const [featureId, data] of Object.entries(selectedFeatures)) {
            features[featureId] = data.name;
        }
        document.getElementById('frm-caseForm-features').value = JSON.stringify(features);
    }

    document.getElementById('frm-caseForm-model').addEventListener('change', function() {
        let modelId = this.value;
        if (modelId) {
            let colorsUrl = this.dataset.colorsUrl.replace('#', encodeURIComponent(modelId));
            let featuresUrl = this.dataset.featuresUrl.replace('#', encodeURIComponent(modelId));
            let priceUrl = this.dataset.priceUrl.replace('#', encodeURIComponent(modelId));
            let imagesUrl = this.dataset.imagesUrl.replace('#', encodeURIComponent(modelId));
            
            Promise.all([
                fetch(colorsUrl)
                    .then(response => response.json())
                    .then(colors => updateColorButtons(colors)),
                fetch(featuresUrl)
                    .then(response => response.json())
                    .then(features => updateFeatureButtons(features)),
                fetch(priceUrl)
                    .then(response => response.json())
                    .then(data => {
                        basePrice = data.price || 0;
                        updateTotalPrice();
                    }),
                fetch(imagesUrl)
                    .then(response => response.json())
                    .then(images => updateCarouselImages(images))
            ]).catch(error => console.error('Error fetching data:', error));
            
            const manufacturerSelect = document.getElementById('frm-caseForm-manufacturer');
            const modelSelect = this;
            const selectedDevice = document.getElementById('selected-device');
            if (manufacturerSelect.value && modelId) {
                selectedDevice.textContent = `${manufacturerSelect.options[manufacturerSelect.selectedIndex].text} ${modelSelect.options[modelSelect.selectedIndex].text}`;
            } else {
                selectedDevice.textContent = 'Vyberte výrobce a model';
            }
        } else {
            basePrice = 0;
            featurePrices = {};
            selectedFeatures = {};
            updateColorButtons([]);
            updateFeatureButtons([]);
            updateCarouselImages([]);
            updateTotalPrice();
            document.getElementById('selected-device').textContent = 'Vyberte výrobce a model';
        }
    });

    function updateColorButtons(colors) {
        const container = document.getElementById('color-buttons');
        container.innerHTML = '';
        colors.forEach(color => {
            const button = document.createElement('button');
            button.setAttribute('type', 'button');
            button.setAttribute('data-color', color.name);
            button.className = `w-10 h-10 rounded-full bg-[${color.hex_code}] hover:ring-2 hover:ring-offset-2 hover:ring-gray-400 transition`;
            button.title = color.name;
            button.addEventListener('click', function() {
                document.querySelectorAll('#color-buttons button').forEach(btn => {
                    btn.classList.remove('ring-2', 'ring-black', 'ring-offset-2');
                });
                this.classList.add('ring-2', 'ring-black', 'ring-offset-2');
                document.getElementById('frm-caseForm-color').value = this.dataset.color;
            });
            container.appendChild(button);
        });
        if (colors.length > 0) {
            container.firstChild.classList.add('ring-2', 'ring-black', 'ring-offset-2');
            document.getElementById('frm-caseForm-color').value = colors[0].name;
        }
    }

    function updateFeatureButtons(features) {
        const container = document.getElementById('features');
        container.innerHTML = '';
        featurePrices = {};
        selectedFeatures = {};

        for (const [featureName, options] of Object.entries(features)) {
            const featureId = featureName.replace(/\s+/g, '_').toLowerCase();
            const featureDiv = document.createElement('div');
            featureDiv.className = 'mt-4';

            const h2 = document.createElement('h2');
            h2.className = 'text-xl font-medium text-gray-900';
            h2.innerText = featureName;
            featureDiv.appendChild(h2);

            const buttonDiv = document.createElement('div');
            buttonDiv.className = 'mt-2 flex flex-wrap gap-3';

            options.forEach(option => {
                const optionDiv = document.createElement('div');
                optionDiv.className = 'flex flex-col items-center';

                const button = document.createElement('button');
                button.setAttribute('type', 'button');
                button.setAttribute('data-feature', featureId);
                button.setAttribute('data-value', option.name);
                button.setAttribute('data-price', option.price);
                button.className = 'px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition';
                button.innerText = option.name;
                button.addEventListener('click', function () { toggleSelection(this); });

                optionDiv.appendChild(button);

                if (option.price > 0) {
                    const priceSpan = document.createElement('span');
                    priceSpan.className = 'text-sm text-gray-500 mt-1';
                    priceSpan.innerText = `+${option.price.toFixed(2)} Kč`;
                    optionDiv.appendChild(priceSpan);
                }

                buttonDiv.appendChild(optionDiv);

                featurePrices[featureId] = featurePrices[featureId] || {};
                featurePrices[featureId][option.name] = option.price;
            });

            featureDiv.appendChild(buttonDiv);
            container.appendChild(featureDiv);

            if (options.length > 0) {
                const firstButton = buttonDiv.querySelector('button');
                toggleSelection(firstButton);
            }
        }
    }

    function updateCarouselImages(images) {
        const track = document.getElementById('carousel-track');
        const dotsContainer = document.getElementById('carousel-dots');
        track.innerHTML = '';
        dotsContainer.innerHTML = '';
        currentImages = images;
        currentSlide = 0;

        if (images.length === 0) {
            // Fallback to a default image if no images are available
            const img = document.createElement('img');
            img.src = '/www/uploads/home/default.jpg'; // Ensure you have a default image
            img.className = 'w-full flex-shrink-0 object-cover h-full';
            img.alt = 'Default Product Image';
            track.appendChild(img);

            const dot = document.createElement('button');
            dot.setAttribute('type', 'button');
            dot.setAttribute('onclick', 'goToSlide(0)');
            dot.className = 'w-3 h-3 bg-gray-400 rounded-full';
            dotsContainer.appendChild(dot);
        } else {
            images.forEach((image, index) => {
                const img = document.createElement('img');
                img.src = image.image_path;
                img.className = 'w-full flex-shrink-0 object-cover h-full';
                img.alt = image.alt_text || `Product Image ${index + 1}`;
                track.appendChild(img);

                const dot = document.createElement('button');
                dot.setAttribute('type', 'button');
                dot.setAttribute('onclick', `goToSlide(${index})`);
                dot.className = `w-3 h-3 ${index === 0 ? 'bg-gray-400' : 'bg-gray-300'} rounded-full`;
                dotsContainer.appendChild(dot);
            });
        }

        updateCarousel();
    }

    function updateTotalPrice() {
        let total = basePrice;
        let breakdown = basePrice > 0 ? [`Základní cena: ${basePrice.toFixed(2)} Kč`] : [];
        
        for (const [feature, data] of Object.entries(selectedFeatures)) {
            if (data.price > 0) {
                total += data.price;
                breakdown.push(`${data.name}: +${data.price.toFixed(2)} Kč`);
            }
        }

        document.getElementById('total-price').textContent = total.toFixed(2) + ' Kč';
        document.getElementById('frm-caseForm-total_price').value = total.toFixed(2);
        document.getElementById('price-breakdown').innerHTML = breakdown.length > 0 ? breakdown.join('<br>') : 'Vyberte model pro zobrazení ceny';
    }

    let currentSlide = 0;
    let totalSlides = currentImages.length || 1;

    function updateCarousel() {
        const track = document.getElementById('carousel-track');
        const dots = document.getElementById('carousel-dots').children;
        totalSlides = track.children.length;
        if (totalSlides === 0) return; // Prevent errors if no images
        const width = track.clientWidth;
        track.style.transform = `translateX(-${currentSlide * width}px)`;
        for (let i = 0; i < dots.length; i++) {
            dots[i].classList.remove('bg-gray-400');
            dots[i].classList.add('bg-gray-300');
        }
        if (dots[currentSlide]) {
            dots[currentSlide].classList.remove('bg-gray-300');
            dots[currentSlide].classList.add('bg-gray-400');
        }
    }

    function nextSlide() {
        if (totalSlides === 0) return;
        currentSlide = (currentSlide + 1) % totalSlides;
        updateCarousel();
    }

    function prevSlide() {
        if (totalSlides === 0) return;
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateCarousel();
    }

    function goToSlide(index) {
        if (totalSlides === 0) return;
        currentSlide = index;
        updateCarousel();
    }

    // Optional auto-slide
    setInterval(nextSlide, 5000);
</script>
{/block}