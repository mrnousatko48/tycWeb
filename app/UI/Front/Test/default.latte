
{block content}
{control form}

<script>
document.querySelectorAll('select[data-depends]').forEach((childSelect) => {
    let parentSelect = childSelect.form[childSelect.dataset.depends];
    let url = childSelect.dataset.url;

    parentSelect.addEventListener('change', () => {
        if (url) {
            console.log('Fetching URL:', url.replace(encodeURIComponent('#'), encodeURIComponent(parentSelect.value)));
            fetch(url.replace(encodeURIComponent('#'), encodeURIComponent(parentSelect.value)))
                .then((response) => {
                    if (!response.ok) {
                        console.error('Fetch error:', response.status, response.statusText);
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then((data) => {
                    console.log('Received data:', data);
                    updateSelectbox(childSelect, data);
                })
                .catch((error) => console.error('Fetch failed:', error));
        }
    });
});

function updateSelectbox(select, items) {
    console.log('Updating select with items:', items);
    select.innerHTML = ''; // Remove all existing options
    let prompt = document.createElement('option');
    prompt.value = '';
    prompt.innerText = '----';
    select.appendChild(prompt);

    for (let id in items) {
        let el = document.createElement('option');
        el.setAttribute('value', id);
        el.innerText = items[id];
        select.appendChild(el);
    }
}
</script>
{/block}