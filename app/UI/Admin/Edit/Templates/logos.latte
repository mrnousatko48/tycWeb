{block content}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6 text-[var(--color-text)]">Upravit loga</h1>

    <div class="bg-[var(--color-background)] p-6 rounded-lg shadow-md">
        <h2 class="text-xl font-semibold mb-4">Nastavení loga pro světlý a tmavý režim</h2>
        
        <div class="mb-6">
            <h3 class="text-lg font-medium">Aktuální loga</h3>
            <div class="flex flex-col md:flex-row gap-4 mt-2">
                <div>
                    <p class="text-sm">Světlý režim:</p>
                    {if $logos['light']}
                        <img src="{$basePath}{$logos['light']}" alt="Logo Light" class="h-16 w-auto mt-2">
                    {else}
                        <p class="text-sm text-gray-500">Žádné logo není nastaveno.</p>
                    {/if}
                </div>
                <div>
                    <p class="text-sm">Tmavý režim:</p>
                    {if $logos['dark']}
                        <img src="{$basePath}{$logos['dark']}" alt="Logo Dark" class="h-16 w-auto mt-2">
                    {else}
                        <p class="text-sm text-gray-500">Žádné logo není nastaveno.</p>
                    {/if}
                </div>
            </div>
        </div>

        {control logoForm}
    </div>
</div>
{/block}