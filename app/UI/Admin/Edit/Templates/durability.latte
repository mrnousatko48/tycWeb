{block content}
{block css}
<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }
    .section-card {
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    .durability-preview {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: center;
    }
    .section-img {
        width: 100%;
        max-height: 350px;
        object-fit: cover;
        border-radius: 0.75rem;
    }
</style>
{/block}

<div class="dashboard-container">
    <h1 class="text-center">Upravit sekci odolnosti</h1>

    <!-- Preview -->
    <div class="section-card">
        <h3 class="text-center">Náhled sekce odolnosti</h3>
        <div class="durability-preview">
            <div>
                <h2 class="text-2xl font-semibold mb-3">{$durability->title}</h2>
                <p class="text-lg mb-3">{$durability->description1}</p>
                <p class="text-lg mb-3">{$durability->description2}</p>
            </div>
            <div>
                <img src="{$durability->image ?? '/Uploads/home/sekera.jpg'}" alt="Odolnost krytu" class="section-img">
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="section-card">
        <h3 class="text-center">Upravit obsah sekce odolnosti</h3>
        {control durabilityForm}
    </div>

    <!-- Back to Dashboard -->
    <div class="mt-4 text-center">
        <a href="{link default}" class="btn btn-secondary">Zpět na nástěnku</a>
    </div>
</div>
{/block}