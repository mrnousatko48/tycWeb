{block content}
{block css}
<link rel="stylesheet" href="/css/dash.css">
{/block}

<div class="container mt-5">
  <h1>Upravit Banner</h1>
  {ifset $banner}
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="card-title">Aktuální obsah</h2>
        <p><strong>Nadpis:</strong> {$banner['title']}</p>
        <p><strong>Popis:</strong> {$banner['description']}</p>
        <p><strong>Text tlačítka:</strong> {$banner['button_text']}</p>
        <p><strong>Odkaz tlačítka:</strong> {$banner['button_link']}</p>
        {if $banner['image']}
          <p><strong>Obrázek:</strong></p>
          <img src="{$banner['image']}" alt="Banner" class="img-fluid" style="max-width: 300px;">
        {/if}
      </div>
    </div>
  {/ifset}

  <h2>Editace</h2>
  {form bannerForm}
    <div class="form-group mb-3">
      {label title /}
      {input title}
    </div>
    <div class="form-group mb-3">
      {label description /}
      {input description}
    </div>
    <div class="form-group mb-3">
      {label button_text /}
      {input button_text}
    </div>
    <div class="form-group mb-3">
      {label button_link /}
      {input button_link}
    </div>
    <div class="form-group mb-3">
      {label image /}
      {input image}
    </div>
    {input save}
  {/form}

  <a href="{link Editdefault}" class="btn btn-secondary mt-3">Zpět na přehled</a>
</div>
{/block}