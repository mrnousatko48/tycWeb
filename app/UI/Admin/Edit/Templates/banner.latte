{block content}
{block css}
<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }
    .section-card {
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    .banner-preview {
        background: url({$banner->image | noescape}?t={time()}) no-repeat center/cover;
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
    }
    .banner-preview .overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
    }
    .banner-content {
        position: relative;
        text-align: center;
        color: white;
        padding: 1.5rem;
    }
</style>
{/block}

<div class="dashboard-container">
    <h1 class="text-center">Upravit banner</h1>

    <!-- Preview -->
    <div class="section-card">
        <h3 class="text-center">Náhled banneru</h3>
        <div class="banner-preview">
            <div class="overlay"></div>
            <div class="banner-content">
                <h1 class="text-3xl font-bold mb-4">{$banner->title}</h1> <!-- Fixed: Use $banner->title -->
                <p class="text-lg mb-6">{$banner->description}</p>
                <a href="{$banner->button_link}" class="btn btn-primary">{$banner->button_text}</a>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="section-card">
        <h3 class="text-center">Upravit obsah banneru</h3>
        {control bannerForm}
    </div>

    <!-- Back to Dashboard -->
    <div class="mt-4 text-center">
        <a href="{link default}" class="btn btn-secondary">Zpět na obsah webu</a>
    </div>
</div>
{/block}