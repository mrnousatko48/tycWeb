{block content}
{block css}
<link rel="stylesheet" href="/css/dash.css">
{/block}

<div class="container mt-5">
  <h1>U Hawkins Gallery</h1>
  {if $galleryImages}
    <div class="gallery-grid mb-4">
      {foreach $galleryImages as $image}
        <div class="gallery-item" data-id="{$image->id}">
          <img src="{$image->image}" alt="{$image->alt_text}" class="img-fluid" style="max-width: 200px;">
          <p><strong>Pořadí:</strong> {$image->ordering}</p>
          <p><strong>Alt text:</strong> {$image->alt_text}</p>
          <a href="{link EditdeleteGalleryImage, id => $image->id}" class="btn btn-sm btn-danger" onclick="return confirm('Opravdu smazat obrázek?')">Smazat</a>
        </div>
      {/foreach}
    </div>
  {/if}

  <h2>Nahrát nový obrázek</h2>
  {form galleryForm}
    <div class="form-group mb-3">
      {label image /}
      {input image}
    </div>
    <div class="form-group mb-3">
      {label alt_text /}
      {input alt_text}
    </div>
    <div class="form-group mb-3">
      {label ordering /}
      {input ordering}
    </div>
    {input save}
  {/form}

  <h2>Upravit pořadí</h2>
  {form galleryOrderForm}
    <div class="form-group mb-3">
      {label order /}
      {input order}
    </div>
    {input save}
  {/form}

  <a href="{link Editdefault}" class="btn btn-secondary mt-3">Zpět na přehled</a>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const galleryItems = document.querySelectorAll('.gallery-item');
      const orderInput = document.querySelector('#order');
      let order = Array.from(galleryItems).map(item => item.dataset.id);

      galleryItems.forEach(item => {
        item.draggable = true;
        item.addEventListener('dragstart', e => {
          e.dataTransfer.setData('text/plain', item.dataset.id);
        });
        item.addEventListener('dragover', e => {
          e.preventDefault();
        });
        item.addEventListener('drop', e => {
          e.preventDefault();
          const draggedId = e.dataTransfer.getData('text/plain');
          const targetId = item.dataset.id;
          const draggedIndex = order.indexOf(draggedId);
          const targetIndex = order.indexOf(targetId);
          order.splice(draggedIndex, 1);
          order.splice(targetIndex, 0, draggedId);
          orderInput.value = JSON.stringify(order);
          galleryItems.forEach((item, index) => {
            item.querySelector('p').textContent = `Pořadí: ${order.indexOf(item.dataset.id) + 1}`;
          });
        });
      });
    });
  </script>
</div>

<style>
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}
.gallery-item {
  border: 1px solid #ddd;
  padding: 1rem;
  border-radius: 0.5rem;
  text-align: center;
  cursor: move;
}
.gallery-item:hover {
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
</style>
{/block}