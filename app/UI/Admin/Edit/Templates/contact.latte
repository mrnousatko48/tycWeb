{block content}
{block css}
<link rel="stylesheet" href="/css/dash.css">
{/block}

<div class="container mt-5">
  <h1>Upravit kontaktní informace</h1>
  {ifset $contact}
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="card-title">Aktuální obsah</h2>
        <p><strong>Jméno:</strong> {$contact->name}</p>
        <p><strong>Adresa:</strong> {$contact->address}</p>
        <p><strong>IČO:</strong> {$contact->ico}</p>
        <p><strong>Telefon:</strong> {$contact->phone}</p>
        <p><strong>Email:</strong> {$contact->email}</p>
        <p><strong>Kód mapy:</strong> {$contact->map_embed|noescape}</p>
      </div>
    </div>
  {/ifset}

  <h2>Editace</h2>
  {form contactForm}
    <div class="form-group mb-3">
      {label name /}
      {input name}
    </div>
    <div class="form-group mb-3">
      {label address /}
      {input address}
    </div>
    <div class="form-group mb-3">
      {label ico /}
      {input ico}
    </div>
    <div class="form-group mb-3">
      {label phone /}
      {input phone}
    </div>
    <div class="form-group mb-3">
      {label email /}
      {input email}
    </div>
    <div class="form-group mb-3">
      {label map_embed /}
      {input map_embed}
    </div>
    {input save}
  {/form}

  <a href="{link Editdefault}" class="btn btn-secondary mt-3">Zpět na přehled</a>
</div>
{/block}