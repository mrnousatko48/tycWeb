{block content}
<div class="container mt-4">
    <h2 class="mb-4">Správa obrázků pro model: {$model->name}</h2>

    <div class="mb-4">
        <a href="{link Product:models}" class="btn btn-secondary">Zpět na modely</a>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header fw-bold">Nahrát nový obrázek</div>
        <div class="card-body">
            {control imageForm}
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">Seznam obrázků</div>
        <div class="card-body" n:snippet="imagesList">
            {if $images->count()}
                <div class="row g-4">
                    {foreach $images as $image}
                        <div class="col-md-3">
                            <div class="card">
                                <img src="{$image->image_path}" class="card-img-top" alt="Obrázek modelu" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <a href="{link deleteImage! $image->id}" class="ajax btn btn-danger btn-sm w-100">🗑 Smazat</a>
                                </div>
                            </div>
                        </div>
                    {/foreach}
                </div>
            {else}
                <p>Žádné obrázky nebyly nalezeny.</p>
            {/if}
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.dataset.originalText = el.innerText;
            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = el.dataset.originalText || 'Uložit';
            }
        } else if (el.tagName === 'A' && el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu chcete tento obrázek smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });
});
</script>
{/block}