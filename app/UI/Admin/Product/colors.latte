{block content}
<div class="container mt-4">
    <h2 class="mb-4">🎨 Barvy</h2>

    {foreach $flashes as $flash}
        <div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
            {$flash->message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
        </div>
    {/foreach}

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">➕ Přidat barvu</div>
                <div class="card-body">
                    {control colorForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">📋 Seznam barev</div>
        <div class="card-body table-responsive" n:snippet="colorsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Název</th>
                        <th>Náhled</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $colors as $color}
                    <tr>
                        <td>{$color->name}</td>
                        <td>
                            <span class="d-inline-block rounded-circle border color-preview" 
                                style="width: 24px; height: 24px; background-color: {$color->hex_code|noescape:'html'};"
                                title="{$color->hex_code}">
                            </span>
                            <span class="text-muted ms-2">{$color->hex_code}</span>


                        </td>
                        <td class="text-end">
                            <a href="{link deleteColor! $color->id}" class="btn btn-sm btn-danger ajax">
                                🗑 Smazat
                            </a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="/js/product.js"></script>
{/block}