{block content}
<div class="container mt-4">
    <h2 class="mb-4">Barvy</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat barvu</div>
                <div class="card-body">
                    {control colorForm}
                </div>
            </div>
        </div>
        <div class="col-md-6" n:if="$presenter->isControlInvalid('colorEditForm')">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Upravit barvu</div>
                <div class="card-body" n:snippet="colorEditForm">
                    {control colorEditForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">Seznam barev</div>
        <div class="card-body table-responsive" n:snippet="colorsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Název</th>
                        <th>Název (CZ)</th>
                        <th>Název (EN)</th>
                        <th>Náhled</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $colors as $color}
                    <tr>
                        <td>{$color->name}</td>
                        <td>{$color->name_cs}</td>
                        <td>{$color->name_en}</td>
                        <td>
                            <span class="d-inline-block rounded-circle border color-preview" 
                                style="width: 24px; height: 24px; background-color: {$color->hex_code|noescape:'html'};"
                                title="{$color->hex_code}">
                            </span>
                            <span class="text-muted ms-2">{$color->hex_code}</span>
                        </td>
                        <td class="text-end">
                            <a href="{link editColor! $color->id}" class="btn btn-sm btn-primary ajax edit-color" data-bs-toggle="modal" data-bs-target="#editColorModal">✏️ Upravit</a>
                            <a href="{link deleteColor! $color->id}" class="btn btn-sm btn-danger ajax">🗑 Smazat</a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for editing colors -->
    <div class="modal fade" id="editColorModal" tabindex="-1" aria-labelledby="editColorModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editColorModalLabel">Upravit barvu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" id="colorEditFormSnippet">
                    {control colorEditForm}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a href="{link default}" class="btn btn-secondary">Zpět na produkty</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script n:syntax=off>
document.addEventListener('DOMContentLoaded', () => {
    // Handle form submissions and AJAX links
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.dataset.originalText = el.innerText;
            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    const target = document.getElementById(snip) || document.getElementById('colorEditFormSnippet');
                    if (target) {
                        target.innerHTML = json.snippets[snip];
                    }
                }
                if (form.closest('#editColorModal')) {
                    bootstrap.Modal.getInstance(document.getElementById('editColorModal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = el.dataset.originalText || 'Uložit';
            }
        } else if (el.tagName === 'A' && el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu chcete tuto položku smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    const target = document.getElementById(snip) || document.getElementById('colorEditFormSnippet');
                    if (target) {
                        target.innerHTML = json.snippets[snip];
                    }
                }
                if (el.classList.contains('edit-color')) {
                    bootstrap.Modal.getInstance(document.getElementById('editColorModal')).show();
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    // Initialize Select2 for all selects in the modal
    $('#editColorModal').on('shown.bs.modal', function () {
        $(this).find('select').select2({
            dropdownParent: $(this),
            width: '100%'
        });
    });

    // Destroy Select2 when modal is hidden to prevent memory leaks
    $('#editColorModal').on('hidden.bs.modal', function () {
        $(this).find('select').select2('destroy');
    });
});
</script>
{/block}