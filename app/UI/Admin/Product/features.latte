{block content}
<div class="container mt-4">
    <h2 class="mb-4">⚙️ Features</h2>

    {foreach $flashes as $flash}
        <div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
            {$flash->message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {/foreach}

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">➕ Add Feature</div>
                <div class="card-body">
                    {snippet featureForm}
                        {control featureForm}
                    {/snippet}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">➕ Add Feature Option</div>
                <div class="card-body">
                    {snippet featureOptionForm}
                        {control featureOptionForm}
                    {/snippet}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">📋 Feature List</div>
        <div class="card-body table-responsive" n:snippet="featuresTable">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr><th>Name</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    {foreach $features as $feature}
                        <tr>
                            <td>{$feature->name}</td>
                            <td class="text-end">
                                <a href="{link deleteFeature! $feature->id}" class="btn btn-sm btn-danger ajax">🗑 Delete</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">📋 Feature Options List</div>
        <div class="card-body table-responsive" n:snippet="featureOptionsTable">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr><th>Feature</th><th>Option</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    {foreach $featureOptions as $option}
                        <tr>
                            <td>{$option->ref('features','feature_id')->name}</td>
                            <td>{$option->name}</td>
                            <td class="text-end">
                                <a href="{link deleteFeatureOption! $option->id}" class="btn btn-sm btn-danger ajax">🗑 Delete</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JS remains unchanged -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('form, a.ajax');
        if (!el) return;

        e.preventDefault();
        if (el.tagName === 'A') {
            if (!confirm('Are you sure?')) return;
            var res = await fetch(el.href, { headers:{'X-Requested-With':'XMLHttpRequest'} });
        } else {
            var data = new FormData(el);
            var res = await fetch(el.action, { method:'POST', body:data, headers:{'X-Requested-With':'XMLHttpRequest'} });
        }
        let json = await res.json();
        for (let snip in json.snippets) {
            document.getElementById(snip).innerHTML = json.snippets[snip];
        }
    });
});
</script>
{/block}
