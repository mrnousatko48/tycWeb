{block content}
<div class="container mt-4">
    <h2 class="mb-4">Vlastnosti</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat Funkce</div>
                <div class="card-body">
                    {snippet featureForm}
                        {control featureForm}
                    {/snippet}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat varianty</div>
                <div class="card-body">
                    {snippet featureOptionForm}
                        {control featureOptionForm}
                    {/snippet}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">Seznam Funkcí</div>
        <div class="card-body table-responsive" n:snippet="featuresTable">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr><th>Název</th><th>Vysvětlivka</th><th>Zobrazit vysvětlivku</th><th class="text-end">Akce</th></tr>
                </thead>
                <tbody>
                    {foreach $features as $feature}
                        <tr>
                            <td>{$feature->name}</td>
                            <td>{if $feature->explanation_mark}{$feature->explanation_mark|truncate:50}{else}—{/if}</td>
                            <td>{if $feature->explanation_mark_enabled}Ano{else}Ne{/if}</td>
                            <td class="text-end">
                                <a href="{link editFeature! $feature->id}" class="btn btn-sm btn-primary ajax edit-feature" data-bs-toggle="modal" data-bs-target="#editFeatureModal">✏️ Upravit</a>
                                <a href="{link deleteFeature! $feature->id}" class="btn btn-sm btn-danger ajax">🗑 Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">Seznam Variant</div>
        <div class="card-body table-responsive" n:snippet="featureOptionsTable">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Funkce</th>
                        <th>Varianta</th>
                        <th>Cena (CZK)</th>
                        <th>Cena (EUR)</th>
                        <th>Mesh Name</th>
                        <th>Viditelnost</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $featureOptions as $option}
                        <tr>
                            <td>{$option->ref('features','feature_id')->name}</td>
                            <td>{$option->name}</td>
                            <td>{$option->price|number:2,',',' '} Kč</td>
                            <td>{$option->price_eur|number:2,',',' '} €</td>
                            <td>{$option->mesh_name ?: '—'}</td>
                            <td>{if $option->visible !== null}{$option->visible ? 'Ano' : 'Ne'}{else}—{/if}</td>
                            <td class="text-end">
                                <a href="{link editFeatureOption! $option->id}" class="btn btn-sm btn-primary ajax edit-feature-option" data-bs-toggle="modal" data-bs-target="#editFeatureOptionModal">✏️ Upravit</a>
                                <a href="{link deleteFeatureOption! $option->id}" class="btn btn-sm btn-danger ajax">🗑 Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for editing features -->
    <div class="modal fade" id="editFeatureModal" tabindex="-1" aria-labelledby="editFeatureModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editFeatureModalLabel">Upravit funkci</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="featureEditForm">
                    {control featureEditForm}
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for editing feature options -->
    <div class="modal fade" id="editFeatureOptionModal" tabindex="-1" aria-labelledby="editFeatureOptionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editFeatureOptionModalLabel">Upravit variantu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="featureOptionEditForm">
                    {control featureOptionEditForm}
                </div>
            </div>
        </div>
    </div>
    <div class="mt-4 text-center">
        <a href="{link default}" class="btn btn-secondary">Zpět na produkty</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Handle form submissions and AJAX links
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.dataset.originalText = el.innerText;
            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                if (form.closest('#editFeatureModal')) {
                    bootstrap.Modal.getInstance(document.getElementById('editFeatureModal')).hide();
                }
                if (form.closest('#editFeatureOptionModal')) {
                    bootstrap.Modal.getInstance(document.getElementById('editFeatureOptionModal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = el.dataset.originalText || 'Uložit';
            }
        } else if (el.tagName === 'A' && el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu chcete tuto položku smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    // Initialize Select2 for all selects in the modals
    ['#editFeatureModal', '#editFeatureOptionModal'].forEach(modalId => {
        $(modalId).on('shown.bs.modal', function () {
            $(this).find('select').select2({
                dropdownParent: $(this),
                width: '100%'
            });
        });

        // Destroy Select2 when modal is hidden to prevent memory leaks
        $(modalId).on('hidden.bs.modal', function () {
            $(this).find('select').select2('destroy');
        });
    });
});
</script>
{/block}