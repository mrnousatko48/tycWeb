{block content}
<div class="container mt-4">
    <h2 class="mb-4">Správa dopravců a možností dopravy</h2>

    {* Flash messages *}
    <div n:snippet="flashes" class="mb-4">
        {foreach $flashes as $flash}
            <div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
                {$flash->message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
            </div>
        {/foreach}
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat dopravce</div>
                <div class="card-body" n:snippet="vendorForm">
                    {control vendorForm}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat možnost dopravy</div>
                <div class="card-body" n:snippet="shippingOptionForm">
                    {control shippingOptionForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header fw-bold">Seznam dopravců</div>
        <div class="card-body table-responsive" n:snippet="vendorsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Název</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $vendors as $id => $name}
                        <tr>
                            <td>{$name}</td>
                            <td>
                                <a href="{link editVendor! $id}" class="btn btn-sm btn-primary ajax edit-vendor" data-bs-toggle="modal" data-bs-target="#editVendorModal">✏️ Upravit</a>
                                <a href="{link deleteVendor! $id}" class="ajax btn btn-danger btn-sm" onclick="return confirm('Opravdu chcete smazat dopravce {$name}?')">🗑 Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">Seznam možností dopravy</div>
        <div class="card-body table-responsive" n:snippet="shippingOptionsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Dopravce</th>
                        <th>Název</th>
                        <th>Cena (CZK)</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $shippingOptions as $option}
                        <tr>
                            <td>{$vendors[$option->vendor_id]}</td>
                            <td>{$option->name}</td>
                            <td>{$option->cost|number:2,',',' '} CZK</td>
                            <td>
                                <a href="{link editShippingOption! $option->id}" class="btn btn-sm btn-primary ajax edit-shipping-option" data-bs-toggle="modal" data-bs-target="#editShippingOptionModal">✏️ Upravit</a>
                                <a href="{link deleteShippingOption! $option->id}" class="ajax btn btn-danger btn-sm" onclick="return confirm('Opravdu chcete smazat možnost dopravy {$option->name}?')">🗑 Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for editing vendors -->
    <div class="modal fade" id="editVendorModal" tabindex="-1" aria-labelledby="editVendorModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editVendorModalLabel">Upravit dopravce</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="vendorEditForm">
                    {control vendorEditForm}
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for editing shipping options -->
    <div class="modal fade" id="editShippingOptionModal" tabindex="-1" aria-labelledby="editShippingOptionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editShippingOptionModalLabel">Upravit možnost dopravy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="shippingOptionEditForm">
                    {control shippingOptionEditForm}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a href="{link default}" class="btn btn-secondary">Zpět na produkty</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script n:syntax=off>
document.addEventListener('DOMContentLoaded', () => {
    // Initialize Select2 for shipping option form
    $('#frm-shippingOptionForm-vendor_id').select2({
        placeholder: 'Vyberte dopravce',
        allowClear: true,
        width: '100%'
    });

    // Handle form submissions and AJAX links
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.dataset.originalText = el.innerText;
            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                if (form.closest('#editVendorModal') || form.closest('#editShippingOptionModal')) {
                    bootstrap.Modal.getInstance(document.getElementById(form.closest('#editVendorModal') ? 'editVendorModal' : 'editShippingOptionModal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = el.dataset.originalText || 'Uložit';
            }
        } else if (el.tagName === 'A' && el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu chcete tuto položku smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    // Initialize Select2 for all selects in both modals
    $('#editVendorModal, #editShippingOptionModal').on('shown.bs.modal', function () {
        $(this).find('select').select2({
            dropdownParent: $(this),
            width: '100%'
        });
    });

    // Destroy Select2 when modals are hidden to prevent memory leaks
    $('#editVendorModal, #editShippingOptionModal').on('hidden.bs.modal', function () {
        $(this).find('select').select2('destroy');
    });
});
</script>
{/block}