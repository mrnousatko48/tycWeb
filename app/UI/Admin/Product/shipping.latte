{block content}
<div class="container mt-4">
    <h2 class="mb-4">Správa dopravy a plateb</h2>

    <div class="row mb-5">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Přidat dopravce</div>
                <div class="card-body" n:snippet="vendorForm">
                    {control vendorForm}
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Způsob dopravy</div>
                <div class="card-body" n:snippet="shippingOptionForm">
                    {control shippingOptionForm}
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Přidat platební metodu</div>
                <div class="card-body" n:snippet="paymentMethodForm">
                    {control paymentMethodForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-header">Dopravci</div>
        <div class="card-body" n:snippet="vendorsTable">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $vendors as $id => $name}
                        <tr>
                            <td>{$name}</td>
                            <td>
                                <a href="{link editVendor! $id}" class="btn btn-sm btn-primary ajax" data-bs-toggle="modal" data-bs-target="#editVendorModal">Upravit</a>
                                <a href="{link deleteVendor! $id}" class="btn btn-sm btn-danger ajax" onclick="return confirm('Opravdu smazat dopravce {$name}?')">Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-header">Možnosti dopravy</div>
        <div class="card-body" n:snippet="shippingOptionsTable">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Dopravce</th>
                        <th>Název</th>
                        <th>Cena (CZK)</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $shippingOptions as $option}
                        <tr>
                            <td>{$vendors[$option->vendor_id]}</td>
                            <td>{$option->name}</td>
                            <td>{$option->cost|number:2,',',' '} CZK</td>
                            <td>
                                <a href="{link editShippingOption! $option->id}" class="btn btn-sm btn-primary ajax" data-bs-toggle="modal" data-bs-target="#editShippingOptionModal">Upravit</a>
                                <a href="{link deleteShippingOption! $option->id}" class="btn btn-sm btn-danger ajax" onclick="return confirm('Opravdu smazat možnost dopravy {$option->name}?')">Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Platební metody</div>
        <div class="card-body" n:snippet="paymentMethodsTable">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Dopravce</th>
                        <th>Kód</th>
                        <th>Název</th>
                        <th>Cena (CZK)</th>
                        <th>Možnosti dopravy</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $paymentMethods as $method}
                        <tr>
                            <td>{$vendors[$method->vendor_id]}</td>
                            <td>{$method->code}</td>
                            <td>{$method->name}</td>
                            <td>{$method->price|number:2,',',' '} CZK</td>
                            <td>
                                {var $linkedOptions = $method->related('shipping_payment_methods')->fetchPairs('shipping_option_id', 'shipping_option_id')}
                                {foreach $shippingOptions as $option}
                                    {if isset($linkedOptions[$option->id])}
                                        {$option->name}{sep}, {/sep}
                                    {/if}
                                {/foreach}
                            </td>
                            <td>
                                <a href="{link editPaymentMethod! $method->id}" class="btn btn-sm btn-primary ajax" data-bs-toggle="modal" data-bs-target="#editPaymentMethodModal">Upravit</a>
                                <a href="{link deletePaymentMethod! $method->id}" class="btn btn-sm btn-danger ajax" onclick="return confirm('Opravdu smazat platební metodu {$method->name}?')">Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="editVendorModal" tabindex="-1" aria-labelledby="editVendorModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editVendorModalLabel">Upravit dopravce</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="vendorEditForm">
                    {control vendorEditForm}
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editShippingOptionModal" tabindex="-1" aria-labelledby="editShippingOptionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editShippingOptionModalLabel">Upravit možnost dopravy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="shippingOptionEditForm">
                    {control shippingOptionEditForm}
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editPaymentMethodModal" tabindex="-1" aria-labelledby="editPaymentMethodModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editPaymentMethodModalLabel">Upravit platební metodu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="paymentMethodEditForm">
                    {control paymentMethodEditForm}
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script n:syntax=off>
document.addEventListener('DOMContentLoaded', () => {
    $('#frm-shippingOptionForm-vendor_id, #frm-paymentMethodForm-vendor_id, #frm-paymentMethodForm-shipping_option_ids').select2({
        width: '100%'
    });

    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                if (form.closest('.modal')) {
                    bootstrap.Modal.getInstance(form.closest('.modal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = 'Uložit';
            }
        } else if (el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    $('.modal').on('shown.bs.modal', function () {
        $(this).find('select').select2({
            dropdownParent: $(this),
            width: '100%'
        });
    });

    $('.modal').on('hidden.bs.modal', function () {
        $(this).find('select').select2('destroy');
    });
});
</script>
{/block}