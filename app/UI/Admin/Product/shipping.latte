{block content}
<div class="container mt-4">
    <h2 class="mb-4">Správa dopravy a plateb</h2>

    <div class="row mb-5">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Přidat dopravce</div>
                <div class="card-body" n:snippet="vendorForm">
                    {control vendorForm}
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Způsob dopravy</div>
                <div class="card-body" n:snippet="shippingOptionForm">
                    {control shippingOptionForm}
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">Přidat platební metodu</div>
                <div class="card-body" n:snippet="paymentMethodForm">
                    {control paymentMethodForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-header">Dopravci</div>
        <div class="card-body" n:snippet="vendorsTable">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Podporované jazyky</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $vendors as $id => $vendor}
                        <tr>
                            <td>{$vendor->name}</td>
                            <td>
                                {var $langs = $vendor->supported_lang ? explode(',', $vendor->supported_lang) : []}
                                {foreach $langs as $lang}
                                    {if $lang == 'cs'}Čeština{elseif $lang == 'en'}English{/if}{sep}, {/sep}
                                {/foreach}
                            </td>
                            <td>
                                <a href="{link editVendor! $id}" class="btn btn-sm btn-primary ajax" data-bs-toggle="modal" data-bs-target="#editVendorModal">Upravit</a>
                                <a href="{link deleteVendor! $id}" class="btn btn-sm btn-danger ajax" onclick="return confirm('Opravdu smazat dopravce {$vendor->name}?')">Smazat</a>
                            </td>
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Rest of the template remains unchanged -->
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script n:syntax=off>
document.addEventListener('DOMContentLoaded', () => {
    $('#frm-shippingOptionForm-vendor_id, #frm-paymentMethodForm-vendor_id, #frm-paymentMethodForm-shipping_option_ids, #frm-vendorForm-supported_lang, #frm-vendorEditForm-supported_lang').select2({
        width: '100%'
    });

    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                if (form.closest('.modal')) {
                    bootstrap.Modal.getInstance(form.closest('.modal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = 'Uložit';
            }
        } else if (el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    $('.modal').on('shown.bs.modal', function () {
        $(this).find('select').select2({
            dropdownParent: $(this),
            width: '100%'
        });
    });

    $('.modal').on('hidden.bs.modal', function () {
        $(this).find('select').select2('destroy');
    });
});
</script>
{/block}