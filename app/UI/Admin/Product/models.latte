{block content}
<div class="container mt-4">
    <h2 class="mb-4">📱 Phone Models</h2>

    {foreach $flashes as $flash}
        <div class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
            {$flash->message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {/foreach}

    <div class="mb-4">
        <label for="manufacturerFilter" class="form-label fw-bold">Filter by Manufacturer:</label>
        <select id="manufacturerFilter" class="form-select" onchange="filterModels(this.value)">
            <option value="">All Manufacturers</option>
            {foreach $manufacturers as $manufacturer}
                <option value="{$manufacturer->id}" n:if="$manufacturer->id == $selectedManufacturerId" selected>
                    {$manufacturer->name}
                </option>
            {/foreach}
        </select>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">➕ Add Manufacturer</div>
                <div class="card-body">
                    {control manufacturerForm}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">➕ Add Model</div>
                <div class="card-body">
                    {control modelForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">📋 Model List</div>
        <div class="card-body table-responsive" n:snippet="modelsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Manufacturer</th>
                        <th>Model</th>
                        <th>Colors</th>
                        <th>Features</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $models as $model}
                    <tr>
                        <td>{$model->ref('manufacturers', 'manufacturer_id')->name}</td>
                        <td>{$model->name}</td>
                        <td>
                            {foreach $model->related('model_colors') as $mc}
                                {var $color = $mc->ref('colors', 'color_id')}
                                <span class="me-2">
                                    {$color->name}
                                    <span class="d-inline-block rounded-circle border" style="width: 16px; height: 16px; background-color: {$color->hex_code};"></span>
                                </span>
                            {/foreach}
                        </td>
                        <td>
                            {foreach $model->related('model_features') as $mf}
                                {var $feature = $mf->ref('features', 'feature_id')}
                                <span class="badge bg-secondary me-1">{$feature->name}</span>
                            {/foreach}
                        </td>
                        <td>
                            <a href="{link deleteModel! $model->id}" class="ajax btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script>
function filterModels(manufacturerId) {
    {if $isAjax}
        window.location.href = {link handleFilterModels! manufacturerId => manufacturerId};
    {/if}
}

document.addEventListener('DOMContentLoaded', () => {
    // Initialize Select2 for color and feature multi-select
    $('#frm-modelForm-color_ids').select2({
        placeholder: 'Select colors',
        allowClear: true,
        width: '100%'
    });
    $('#frm-modelForm-feature_ids').select2({
        placeholder: 'Select features',
        allowClear: true,
        width: '100%'
    });

    // Handle form submissions and delete actions via AJAX
    document.querySelectorAll('form, a.ajax').forEach(element => {
        element.addEventListener('click', async (e) => {
            if (element.tagName === 'A') {
                e.preventDefault();
                const response = await fetch(element.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                if (data.snippets) {
                    Object.keys(data.snippets).forEach(snippet => {
                        document.getElementById(snippet).innerHTML = data.snippets[snippet];
                    });
                }
            }
        });

        if (element.tagName === 'FORM') {
            element.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(element);
                const response = await fetch(element.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                if (data.snippets) {
                    Object.keys(data.snippets).forEach(snippet => {
                        document.getElementById(snippet).innerHTML = data.snippets[snippet];
                    });
                }
                // Re-initialize Select2 after AJAX update
                $('#frm-modelForm-color_ids').select2({
                    placeholder: 'Select colors',
                    allowClear: true,
                    width: '100%'
                });
                $('#frm-modelForm-feature_ids').select2({
                    placeholder: 'Select features',
                    allowClear: true,
                    width: '100%'
                });
            });
        }
    });

    // Add delete confirmation
    document.querySelectorAll('a.ajax').forEach(link => {
        link.addEventListener('click', (e) => {
            if (!confirm('Are you sure you want to delete this item?')) {
                e.preventDefault();
            }
        });
    });
});
</script>
{/block}