{block content}
<div class="container mt-4">
    <h2 class="mb-4">Modely telefonů</h2>
    <a n:href="Product:defaultImages" class="btn btn-sm btn-primary">Defaultní obrázky</a>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat výrobce</div>
                <div class="card-body">
                    {control manufacturerForm}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Přidat model</div>
                <div class="card-body">
                    {control modelForm}
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header fw-bold">Seznam výrobců</div>
        <div class="card-body table-responsive" n:snippet="manufacturersTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Název</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $manufacturers as $manufacturer}
                    <tr>
                        <td>{$manufacturer->name}</td>
                        <td>
                            <a href="{link editManufacturer! $manufacturer->id}" class="btn btn-sm btn-primary ajax edit-manufacturer" data-bs-toggle="modal" data-bs-target="#editManufacturerModal">✏️ Upravit</a>
                            <a href="{link deleteManufacturer! $manufacturer->id}" class="ajax btn btn-danger btn-sm">🗑 Smazat</a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">Seznam modelů</div>
        <div class="card-body table-responsive" n:snippet="modelsTable">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Výrobce</th>
                        <th>Model</th>
                        <th>Základní cena (CZK)</th>
                        <th>Barvy</th>
                        <th>Funkce</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $models as $model}
                    <tr>
                        <td>{$model->ref('manufacturers', 'manufacturer_id')->name}</td>
                        <td>{$model->name}</td>
                        <td>{$model->price|number:2,',',' '} CZK</td>
                        <td>
                            {foreach $model->related('model_colors') as $mc}
                                {var $color = $mc->ref('colors', 'color_id')}
                                <span class="me-2">
                                    <span class="d-inline-block rounded-circle border" style="width: 16px; height: 16px; background-color: {$color->hex_code|noescape:'html'};"></span>
                                </span>
                            {/foreach}
                        </td>
                        <td>
                            {foreach $model->related('model_features') as $mf}
                                {var $feature = $mf->ref('features', 'feature_id')}
                                <span class="badge bg-secondary me-1">{$feature->name}</span>
                            {/foreach}
                        </td>
                        <td>
                            <a href="{link editModel! $model->id}" class="btn btn-sm btn-primary ajax edit-model" data-bs-toggle="modal" data-bs-target="#editModelModal">✏️ Upravit</a>
                            <a href="{link deleteModel! $model->id}" class="ajax btn btn-danger btn-sm">🗑 Smazat</a>
                            <a href="{link Product:images $model->id}" class="btn btn-sm btn-info">📷 Spravovat obrázky</a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for editing manufacturers -->
    <div class="modal fade" id="editManufacturerModal" tabindex="-1" aria-labelledby="editManufacturerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editManufacturerModalLabel">Upravit výrobce</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="manufacturerEditForm">
                    {control manufacturerEditForm}
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for editing models -->
    <div class="modal fade" id="editModelModal" tabindex="-1" aria-labelledby="editModelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModelModalLabel">Upravit model</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body" n:snippet="modelEditForm">
                    {control modelEditForm}
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script n:syntax=off>
document.addEventListener('DOMContentLoaded', () => {
    // Initialize Select2 for model form
    $('#frm-modelForm-color_ids, #frm-modelForm-feature_options').select2({
        placeholder: 'Vyberte',
        allowClear: true,
        width: '100%'
    });

    // Handle form submissions and AJAX links
    document.body.addEventListener('click', async e => {
        let el = e.target.closest('button[type="submit"], a.ajax');
        if (!el) return;

        e.preventDefault();

        if (el.tagName === 'BUTTON' && el.type === 'submit') {
            const form = el.closest('form');
            if (!form) return;

            el.dataset.originalText = el.innerText;
            el.disabled = true;
            el.innerText = 'Ukládám...';

            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                if (form.closest('#editModelModal') || form.closest('#editManufacturerModal')) {
                    bootstrap.Modal.getInstance(document.getElementById(form.closest('#editModelModal') ? 'editModelModal' : 'editManufacturerModal')).hide();
                }
            } catch (error) {
                console.error('Chyba:', error);
            } finally {
                el.disabled = false;
                el.innerText = el.dataset.originalText || 'Uložit';
            }
        } else if (el.tagName === 'A' && el.classList.contains('ajax')) {
            if (el.classList.contains('btn-danger') && !confirm('Opravdu chcete tuto položku smazat?')) {
                return;
            }

            try {
                const res = await fetch(el.href, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();
                for (let snip in json.snippets) {
                    document.getElementById(snip).innerHTML = json.snippets[snip];
                }
                // Handle redirect for Defaultní obrázky button if needed
                if (el.textContent.trim() === 'Defaultní obrázky') {
                    window.location.href = el.href; // Force full page load for now
                }
            } catch (error) {
                console.error('Chyba:', error);
            }
        }
    });

    // Initialize Select2 for all selects in both modals
    $('#editModelModal, #editManufacturerModal').on('shown.bs.modal', function () {
        $(this).find('select').select2({
            dropdownParent: $(this),
            width: '100%'
        });
    });

    // Destroy Select2 when modals are hidden to prevent memory leaks
    $('#editModelModal, #editManufacturerModal').on('hidden.bs.modal', function () {
        $(this).find('select').select2('destroy');
    });
});
</script>
{/block}