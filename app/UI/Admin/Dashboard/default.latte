{block content}
{block css}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
{/block}

<div class="container py-5 text-center">
    <h1 class="mb-5">Administrátorská nástěnka</h1>

    <div class="row g-4 justify-content-center">

        <div class="col-12 col-sm-6 col-lg-3">
            <a n:href="Dashboard:orders" class="btn btn-primary w-100 py-4 fs-4 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-bag-check-fill mb-2 fs-1"></i>
                Objednávky
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a n:href="Product:default" class="btn btn-success w-100 py-4 fs-4 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-box-seam mb-2 fs-1"></i>
                Produkty
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a n:href="Edit:default" class="btn btn-warning w-100 py-4 fs-4 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-layout-text-window-reverse mb-2 fs-1"></i>
                Obsah Webu
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a n:href="Dashboard:emails" class="btn btn-info w-100 py-4 fs-4 d-flex flex-column align-items-center justify-content-center text-white">
                <i class="bi bi-bell-fill mb-2 fs-1"></i>
                Emaily a notifikace
            </a>
        </div>

    </div>
</div>
{/block}
